<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IgorCoin - Detsentraliseeritud Krüptovaluuta</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #f0f8ff;
            color: #333;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }
        header {
            background-color: #FF6347;
            width: 100%;
            text-align: center;
            padding: 20px;
            color: white;
            font-size: 2rem;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .container {
            text-align: center;
            margin-top: 20px;
        }
        .crypto-info {
            background-color: #ffffe0;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
            font-size: 1.2rem;
            color: #2f4f4f;
        }
        .crypto-info h3 {
            margin: 0;
            color: #ff4500;
        }
        .crypto-info p {
            margin: 5px 0;
        }
        .graph {
            width: 80%;
            height: 400px;
            background-color: #ffffff;
            border-radius: 10px;
            border: 1px solid #ccc;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .footer {
            background-color: #FF6347;
            width: 100%;
            text-align: center;
            padding: 10px;
            color: white;
            font-size: 1rem;
        }
    </style>
</head>
<body>

    <header>
        IgorCoin - Detsentraliseeritud Krüptovaluuta
    </header>

    <div class="container">
        <div class="crypto-info">
            <h3>IgorCoin</h3>
            <p>IgorCoin on detsentraliseeritud krüptovaluuta, mille eesmärk on pakkuda turvalisi ja kiireid tehinguid ilma vahendajateta.</p>
            <p>Uus ja võimas krüptovaluuta, mis pakub parimaid investeerimisvõimalusi.</p>
        </div>

        <div class="crypto-info">
            <h3>Krüptovaluutade Reaalajas Kursid</h3>
            <p>Jälgi erinevate krüptovaluutade kursse reaalajas!</p>
            <p id="cryptoRates"></p>
        </div>

        <div class="graph" id="cryptoGraph">
            <canvas id="cryptoCanvas"></canvas>
        </div>
    </div>

    <div class="footer">
        IgorCoin 2025 - Kõik õigused kaitstud
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Funktsioon krüptovaluutade kursi värskendamiseks
        async function fetchCryptoData() {
            const response = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,usd-coin&vs_currencies=eur');
            const data = await response.json();
            
            const btcRate = data.bitcoin.eur;
            const ethRate = data.ethereum.eur;
            const usdcRate = data['usd-coin'].eur;
            
            document.getElementById('cryptoRates').innerHTML = `
                <strong>Bitcoin (BTC):</strong> €${btcRate} <br>
                <strong>Ethereum (ETH):</strong> €${ethRate} <br>
                <strong>USD Coin (USDC):</strong> €${usdcRate}
            `;
        }

        // Graafiku koostamine Chart.js abil
        function createCryptoGraph() {
            const ctx = document.getElementById('cryptoCanvas').getContext('2d');
            const chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['00:00', '06:00', '12:00', '18:00', '24:00'],
                    datasets: [{
                        label: 'Bitcoin (BTC)',
                        data: [30000, 32000, 34000, 35000, 37000],
                        borderColor: 'rgba(255, 99, 132, 1)',
                        fill: false,
                        tension: 0.1
                    }, {
                        label: 'Ethereum (ETH)',
                        data: [2000, 2100, 2200, 2300, 2400],
                        borderColor: 'rgba(54, 162, 235, 1)',
                        fill: false,
                        tension: 0.1
                    }, {
                        label: 'USD Coin (USDC)',
                        data: [1, 1, 1, 1, 1],
                        borderColor: 'rgba(75, 192, 192, 1)',
                        fill: false,
                        tension: 0.1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'top',
                        },
                        tooltip: {
                            callbacks: {
                                label: function(tooltipItem) {
                                    return tooltipItem.dataset.label + ': €' + tooltipItem.raw;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: false
                        }
                    }
                }
            });
        }

        // Kutsu funktsioonid
        fetchCryptoData();
        createCryptoGraph();
    </script>

</body>
</html>

